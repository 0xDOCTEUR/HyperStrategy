# Copie ce fichier en .env pour tests locaux.
# Pour le 24h/24 : secrets GitHub Actions.
# Plusieurs destinations : sépare les ids par des virgules
# (privé + groupe, ex. 123456,-100987654)

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TELEGRAM_ASSETS=BTC,ETH,SOL,HYPE
TELEGRAM_INTERVAL=4h
TELEGRAM_EVERY_HOURS=4
TELEGRAM_ALERT_EVERY_MIN=30
TELEGRAM_SEND_ON_START=1
